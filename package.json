{
  "name": "plataforma-debate-analise-critica",
  "version": "1.0.0",
  "description": "Protótipo da plataforma de análise crítica de debates com fluxo de ciclos, questionários e administração",
  "main": "backend/server.js",
  "scripts": {
    "start": "npm run build && node backend/server.js",
    "dev": "concurrently -k -n API,WEB \"npm:dev:server\" \"vite --host 0.0.0.0\"",
    "dev:server": "node --watch backend/dev-server.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "debates",
    "educacao",
    "ia",
    "api",
    "express"
  ],
  "author": "Copilot",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@tailwindcss/vite": "^4.0.6",
    "tailwindcss": "^4.0.6",
    "vite": "^6.0.7",
    "concurrently": "^9.1.2"
  }
}
